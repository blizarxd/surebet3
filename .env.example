# Copia este archivo como .env y rellena lo que uses. Nunca subas .env a ningún lado.

# --- Escaneo ---
MODE=all                 # all = vivo + próximas HORIZON_H horas | live = solo en vivo
HORIZON_H=24
POLY_INTERVAL_S=3        # cada cuánto se refrescan los order books de Polymarket

# --- Arbitraje ---
STAKE=100                # monto total de referencia a repartir entre las apuestas
MIN_MARGIN_PCT=0.5       # margen mínimo para mostrar/alertar
MAX_BANKROLL=5000        # tope para calcular el monto máximo por oportunidad
MAX_AGE_LIVE_S=15        # en vivo, cuotas más viejas que esto no cuentan
MAX_AGE_PREMATCH_S=900
OUTLIER_PP=0.08          # descarta patas que pagan >8 puntos de probabilidad sobre el consenso de 3+ casas

# Solo oportunidades en casas donde tienes cuenta (keys de The Odds API, separadas por coma).
# Vacío = todas. Ej: MY_BOOKS=pinnacle,onexbet,betsson
MY_BOOKS=

# --- The Odds API (https://the-odds-api.com) ---
ODDS_API_KEY=
ODDS_API_SPORTS=upcoming         # o lista: soccer_spain_la_liga,icehockey_nhl,...  (1 crédito c/u por llamada)
ODDS_API_REGIONS=eu              # eu, uk, us, au (cada región extra multiplica el costo)
ODDS_API_BOOKMAKERS=             # alternativa a regions: pinnacle,onexbet,...
ODDS_API_INTERVAL_S=21600        # cada 6 h. Plan gratis = 500 créditos/mes: no bajes esto sin plan de pago
ODDS_API_MIN_CREDITS=50          # deja de consultar al llegar a esta reserva
COMMISSIONS=betfair_ex_eu:0.05,betfair_ex_uk:0.05,matchbook:0.02,smarkets:0.02

# --- 1xBet (feed público, gratis, prepartido y EN VIVO; 888starz = mismas cuotas) ---
ONEXBET_ENABLED=1
ONEXBET_BASE=https://1xbet-col.com     # espejo que responde con tu VPN; si cambias de país puede cambiar
ONEXBET_PARTNER=285                    # id del espejo (aparece en la web como p=285)
ONEXBET_SPORTS=1,3,4,10,40,2,6         # 1 fútbol, 3 básquet, 4 tenis, 10 tenis de mesa, 40 esports, 2 hockey, 6 vóley
ONEXBET_PREMATCH_S=120                 # no bajar mucho: 1xBet bloquea la IP si se le pide demasiado
ONEXBET_LIVE_S=10

# --- OddsPapi (https://oddspapi.io): 1xBet, Stake, Rollbit, Pinnacle... ---
# Plan gratis: 250 peticiones/mes, SOLO prepartido. Una ronda ~4 peticiones (1 por deporte + 1 por casa).
ODDSPAPI_KEY=
ODDSPAPI_SPORTS=10                     # 10 fútbol, 11 basket, 12 tenis, 13 béisbol, 15 hockey, 16-18 esports
ODDSPAPI_BOOKMAKERS=stake,rollbit      # 1xBet ya viene gratis del feed directo
ODDSPAPI_INTERVAL_H=3                  # separación mínima entre rondas
ODDSPAPI_MIN_KICKOFF=5                 # ronda solo si hay >= 5 partidos de Polymarket que empiezan en 1-3 h
ODDSPAPI_RESERVE=20

# --- Apuestas de valor (cuota de la casa > probabilidad justa de Polymarket) ---
VALUE_MIN_EV_PCT=2.0                   # mostrar
VALUE_LOG_MIN_EV_PCT=0.0               # registrar en papel para medir CLV (más datos)
VALUE_ALERT_MIN_EV_PCT=4.0
VALUE_MIN_POLY_DEPTH=1000              # USDC cerca del precio en Polymarket para usarlo de referencia
VALUE_MAX_ODDS=10                      # con cuotas más altas el precio de Polymarket no es referencia fiable
BANKROLL=500                           # para el monto sugerido (Kelly fraccional, tope 3% de la banca)
KELLY_FRACTION=0.25

# --- Cuenta en papel y panel ---
PAPER_BANKROLL=1000                    # capital para surebets
PAPER_ARB_STAKE=100                    # total por surebet, repartido entre los lados
PAPER_TAKE_VALUE=0                     # 1 = el papel también toma apuestas de valor (un solo lado)
PAPER_VALUE_MAX_PCT=0.03               # si se toman: Kelly/4 con tope de 3 % del capital
DASHBOARD_PORT=8765

# --- Emparejamiento ---
MATCH_THRESHOLD=85
MATCH_WINDOW_MIN=120

# --- Alertas ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_MIN_MARGIN_PCT=1.0
BEEP=1

# --- Cuentas propias y rotación ---
# MY_BOOKS=1xbet,onexbet,stake,rollbit,sxbet,cloudbet
ROTATE_BOOKS=1xBet,888starz            # clones de 1xBet donde tienes UNA cuenta a tu nombre; el aviso rota entre ellas

# --- SX Bet (exchange, lectura pública sin key) y Cloudbet (Feed API) ---
SXBET_ENABLED=1
CLOUDBET_API_KEY=                      # key de Cloudbet; solo en .env, nunca en el código

# --- Cuenta en papel: medición y cuenta "real" ---
PAPER_ENABLED=1
PAPER_MEASURE=1                        # además registra TODO a $PAPER_MEASURE_STAKE fijo para medir
PAPER_MEASURE_STAKE=100
PAPER_INCLUDE_LIVE=0                   # la cuenta real solo toma prepartido
PAPER_REAL_MAX_HOURS=6                 # solo partidos que empiezan en <= 6 h (no inmoviliza capital)
PAPER_REAL_MIN_NET_PCT=0.5             # neto mínimo (sube a 1-1.5 % cuando falta efectivo)
PAPER_LIVE_DELAY_S=8                   # retraso de aceptación simulado en vivo
PAPER_MIN_PERSIST_S=5

# --- Panel y reporte ---
PANEL_URL=                             # ej. http://TU_VPS/surebet/ (sale en los avisos de Telegram)
DAILY_REPORT_HOUR=9                    # resumen diario por Telegram (hora local del servicio)

# --- Qué llega a Telegram (solo prepartido) ---
ALERT_MIN_NET_PCT=1.0                  # neto mínimo después de comisiones
ALERT_MAX_HOURS=6                      # solo partidos que empiezan en <= 6 h
ALERT_MIN_STAKE=50                     # que aguante al menos este monto total
ALERT_REPEAT_MIN=60                    # no repetir el mismo partido/mercado antes (salvo que mejore +0.5 %)

# --- Cuenta en papel de apuestas de valor "oro" ---
VALUE_BANKROLL=1000

# --- Botón de Telegram "Ya aposté en 1xBet → comprar en Polymarket" ---
# Por defecto DEMO: calcula y anota la compra pero NO envía nada.
POLY_LIVE=0                            # 1 = órdenes reales (solo con la clave puesta)
POLY_PRIVATE_KEY=                      # clave privada de TU wallet de Polymarket. Solo aquí, nunca en chats ni en git
POLY_FUNDER=                           # dirección del proxy/wallet de Polymarket si entras con email/Magic (si no, vacío)
POLY_SIGNATURE_TYPE=0                  # 0 = wallet propia (MetaMask); 1 = email/Magic; 2 = proxy de navegador
POLY_MAX_ORDER_USD=150                 # tope por compra
POLY_MAX_DAILY_USD=600                 # tope por día
VALUE_MIN_TOTAL=30                     # apuestas de valor: mínimo entre 1xBet + la red de Polymarket (sin red, la mitad en la casa)
VALUE_MAX_IN_PLAY=1000                 # tope de dinero en juego a la vez (1xBet + órdenes de Polymarket); el aviso advierte si te pasas
